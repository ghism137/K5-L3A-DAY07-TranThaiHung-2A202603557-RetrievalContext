# Copy to .env and fill in your own key. .env is ignored by git; never commit or print it.

# Local-only connection for docker-compose.yml (Day 7 container, port 55434).
DATABASE_URL=postgresql://day7:day7_local_only@127.0.0.1:55434/day7_lab

# Embeddings: must stay the same model that built the Day 6 index.
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# Agent model (chat completions with tool calling). Choose and record it in the report.
AGENT_MODEL=
